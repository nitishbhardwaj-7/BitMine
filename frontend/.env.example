# Copy to .env (or .env.local). Everything here ships inside the app: public values only.
VITE_API_URL=http://localhost:4000
# RevenueCat public SDK keys (Project settings → API keys): appl_… and goog_…
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=
# Google sign-in: the Web OAuth client ID from Google Cloud / Firebase
VITE_GOOGLE_WEB_CLIENT_ID=
# Browser testing: finish claims/purchases via the backend's DEV_SHORTCUTS (needs DEV_SHORTCUTS=true there)
VITE_DEV_SHORTCUTS=true
VITE_APP_VERSION=1.0.0

# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000
ADMIN_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000

# MongoDB must be a replica set (Atlas is); transactions are required for the ledger.
MONGODB_URI=

# Signs 15-minute access tokens (refresh tokens are random and stored hashed). 32+ chars.
JWT_ACCESS_SECRET=
ADMIN_SESSION_SECRET=

REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
ALLOW_SANDBOX=false

SPEED_API_KEY=
SPEED_API_BASE=https://api.tryspeed.com

ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Push notifications: a Firebase service account (private key with 
 for line breaks).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Sign in with Google/Apple: comma-separated OAuth client IDs, and the iOS bundle id.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=

# Email codes. Without a key: logged to the console in development, disabled in production.
BREVO_API_KEY=
MAIL_FROM=
SENTRY_DSN=

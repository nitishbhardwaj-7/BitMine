# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Browser origins allowed to call the API (the phone app sends no Origin header):
# the Vite dev server and the Capacitor WebView origins.
CORS_ORIGINS=http://localhost:4000,http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,https://localhost,http://localhost

# Which proxy hop to trust for the client IP: "loopback" = nginx/Caddy on the same
# host (default); "uniquelocal" = a reverse proxy on a private/Docker network.
TRUST_PROXY=loopback

# Development only: finish claims/purchases from the browser build. Always off in production.
DEV_SHORTCUTS=false

# MongoDB must be a replica set (Atlas is); transactions are required for the ledger.
# Include the database name, e.g. ...mongodb.net/bitmine?retryWrites=true&w=majority
MONGODB_URI=

# Signs 15-minute access tokens (refresh tokens are random and stored hashed). 32+ random chars.
JWT_ACCESS_SECRET=

# RevenueCat: secret API key (v1) and the Authorization value set on the webhook.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Accept sandbox (test) purchases. Only ever true on a staging server.
ALLOW_SANDBOX=false

# Speed wallet: payouts pause until this is set.
SPEED_API_KEY=
SPEED_API_BASE=https://api.tryspeed.com

ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Push notifications: a Firebase service account. Keep the private key on one
# line with \n for line breaks (as in the downloaded JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sign in with Google/Apple: comma-separated OAuth client IDs (web + Android + iOS), and the iOS bundle id.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=com.bitmine.app

# Email codes. Required in production: sign-up, 2FA and password reset depend on it.
# Use SMTP (any provider) or Brevo. Without either in development, codes are printed in the API console.
MAIL_FROM=
MAIL_FROM_NAME=BitMine
# SMTP: port 465 = TLS from the start, 587 = STARTTLS. SMTP_SECURE is optional (derived from the port).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Or Brevo HTTP API (takes precedence over SMTP when set):
BREVO_API_KEY=
# Temporary private-test switch: codes go to the server log when no provider is set. Remove for real users.
MAIL_LOG_ONLY=false
